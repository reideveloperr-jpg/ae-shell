{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (full: plugin + UI)",
      "description": "Builds the AEGP plugin and the Qt UI on Windows.",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AE_SHELL_BUILD_PLUGIN": "ON",
        "AE_SHELL_BUILD_UI": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64-debug",
      "inherits": "windows-x64-release",
      "displayName": "Windows x64 Debug (full)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ui-only-release",
      "displayName": "UI only — Release (no AE SDK required)",
      "description": "Builds just the standalone Qt UI; useful for CI and design iteration.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AE_SHELL_BUILD_PLUGIN": "OFF",
        "AE_SHELL_BUILD_UI": "ON",
        "AE_SHELL_BUILD_STANDALONE_UI": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release", "configuration": "Release" },
    { "name": "windows-x64-debug",   "configurePreset": "windows-x64-debug",   "configuration": "Debug"   },
    { "name": "ui-only-release",     "configurePreset": "ui-only-release",     "configuration": "Release" }
  ]
}
